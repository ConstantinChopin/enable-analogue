# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# build variant used to avoid dev-server dist collisions
/.next-build/


# image-generation scratch. These live under public/, so anything committed here is
# served at the production URL — run logs and the review contact sheet are working
# files, not part of the app.
public/records/_log.txt
public/records/_gen.txt
public/records/_gen-variants.txt
public/_contact-sheet.html

# eval screenshots are build output, not source
evals/shots/
evals/tier3-report.json
